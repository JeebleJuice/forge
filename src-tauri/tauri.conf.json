{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Forge",
  "version": "0.2.0",
  "identifier": "dev.jeeblejuice.forge",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1422",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "label": "main",
      "title": "Forge",
      "width": 1440,
      "height": 900,
      "minWidth": 1020,
      "minHeight": 680,
      "decorations": true,
      "resizable": true,
      "dragDropEnabled": true
    }],
    "security": {
      "csp": "default-src 'self'; img-src 'self' blob: data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["rpm", "appimage"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"],
    "category": "Utility",
    "shortDescription": "Private local file toolbox",
    "longDescription": "Convert, resize, compress, and clean everyday image and video files without uploading them."
  }
}
